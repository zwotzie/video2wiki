# OpenAI-kompatible API (default: https://api.openai.com/v1)
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# LLM-Modell (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# SSL-Verifikation (default: true; auf false bei internen CAs)
# OPENAI_SSL_VERIFY=true

# Strukturierte Outputs (json_schema) nutzen (default: true; auf false bei Endpunkten
# die nur json_object unterstützen)
# OPENAI_STRUCTURED_OUTPUT=true
